# Banco PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=hell_on_tap

# Porta da API (3000 = jogo, 3001 = front)
PORT=3333

# Origens que podem chamar a API pelo navegador, separadas por vírgula.
# Vazio = qualquer origem.
CORS_ORIGIN=

# Segredo dos tokens de login: use um valor longo e aleatório
# (ex.: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))")
JWT_SECRET=
