# Banco PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=hell_on_tap

# Porta da API (2500 = jogo, 3000 = front)
PORT=2000

# Origens que podem chamar a API pelo navegador, separadas por vírgula.
# Vazio = qualquer origem.
CORS_ORIGIN=

# Segredo dos tokens de login: use um valor longo e aleatório
# (ex.: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))")
JWT_SECRET=

# Link do servidor do jogo (o site busca em GET /config para abrir o jogo e listar as salas).
GAME_URL=http://localhost:2500

# Chave compartilhada entre jogo e API para registrar abates, mortes e horas de jogo.
# Use o mesmo valor nos dois .env (gere com: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))").
GAME_SERVER_KEY=
